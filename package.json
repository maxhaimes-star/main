{
  "name": "ojb-cube",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "vitest run",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p client",
    "build-cube": "tsx scripts/build-cube.ts",
    "build-carddb": "bash scripts/fetch-forge.sh",
    "crop-pdf": "python3 scripts/crop_pdf.py",
    "e2e": "node e2e/smoke.mjs && node e2e/auction.mjs && node e2e/engine2.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "concurrently": "^9.1.2",
    "playwright": "^1.64.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
